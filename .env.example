# Everything here is OPTIONAL — league 90528 / season 2026 are baked into
# api/espn-sync.js as defaults, so local dev and Vercel both work with no
# configuration. These only exist to point the app at a different league.

# ESPN_LEAGUE_ID=90528
# ESPN_SEASON=2026

# Only needed if the league is ever switched to private.
# ESPN_S2=
# ESPN_SWID=

# Client-side overrides (read via import.meta.env), if you want the browser
# to request a different league than the server default.
# VITE_ESPN_LEAGUE_ID=90528
# VITE_ESPN_SEASON=2026
